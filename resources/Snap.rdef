/*
 * Snap's application resources. The shaders are in Shaders.rdef, which the
 * Makefile writes from the files in src/effects/shaders.
 */

resource app_signature "application/x-vnd.airOS-Snap";

// A camera serves one program at a time: launching Snap again brings the
// running one to the front.
resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major = 1,
	middle = 0,
	minor = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Snap 1.0",
	long_info = "A photo booth for air/OS: live camera effects drawn by the "
		"graphics card, some of them dancing to sound."
};

resource vector_icon {
	import "branding/snap-icon.hvif"
};
